# Tea provider smoke-test configuration
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# never committed; keep your real API key out of version control.
#
# The live smoke tests are `#[ignore]`d and never run in CI. Run them locally:
#   cargo test -p tea-provider-openai --test smoke --features live -- --ignored --nocapture
#   TEA_CLI_LIVE_SMOKE=1 cargo test -p tea-cli --test live_smoke -- --ignored --nocapture
# The CLI test loads this `.env` file itself (no dotenv dependency). It uses
# TEA_PROVIDER to select one provider contract and fails clearly when that
# provider's required variables are missing.

# ---------------------------------------------------------------------------
# Required for any live request
# ---------------------------------------------------------------------------

# Explicit opt-in for the end-to-end Coding CLI smoke. The test still skips
# unless this flag is set to 1.
TEA_CLI_LIVE_SMOKE=0

# Provider exercised by the CLI smoke: openai | anthropic.
TEA_PROVIDER=openai

# ---------------------------------------------------------------------------
# OpenAI-compatible live provider
# ---------------------------------------------------------------------------

# OpenAI-compatible base URL. Use https://api.openai.com/v1 for real OpenAI,
# or your gateway / proxy base URL (without the /chat/completions suffix).
TEA_OPENAI_BASE_URL=https://api.openai.com/v1

# API key (secret). Leave empty in this template; fill it in your local .env.
TEA_OPENAI_API_KEY=

# Default model id used by the smoke tests, e.g. gpt-4o-mini, gpt-4o, gpt-4.1.
TEA_OPENAI_MODEL=

# API endpoint mode: chat-completions (default) | responses.
# TEA_OPENAI_API_MODE=chat-completions

# ---------------------------------------------------------------------------
# Optional authentication shape (for OpenAI-compatible gateways)
# ---------------------------------------------------------------------------

# Header name that carries the key. Default: Authorization.
# TEA_OPENAI_API_KEY_HEADER=Authorization

# Prefix prepended to the key value (trailing space included). Default: "Bearer ".
# Set empty for gateways that expect a bare key in a custom header.
# TEA_OPENAI_API_KEY_PREFIX=Bearer 

# ---------------------------------------------------------------------------
# Optional OpenAI-specific headers
# ---------------------------------------------------------------------------

# TEA_OPENAI_ORG_ID=
# TEA_OPENAI_PROJECT_ID=

# ---------------------------------------------------------------------------
# Optional reasoning-model controls
# ---------------------------------------------------------------------------

# Reasoning effort for o-series models: low | medium | high (unset = none).
# TEA_OPENAI_REASONING_EFFORT=

# Set to 1 to exercise image input in the smoke test.
# TEA_OPENAI_VISION=0

# ---------------------------------------------------------------------------
# Optional transport
# ---------------------------------------------------------------------------

# Per-request timeout in milliseconds. Default: 60000.
# TEA_OPENAI_REQUEST_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Anthropic Messages live provider
# ---------------------------------------------------------------------------

# API root without /v1/messages. The adapter appends that path.
TEA_ANTHROPIC_BASE_URL=https://api.anthropic.com

# API key sent in the x-api-key header.
TEA_ANTHROPIC_API_KEY=

# Anthropic model id, e.g. claude-sonnet-4-20250514.
TEA_ANTHROPIC_MODEL=

# Anthropic protocol version and request timeout defaults.
TEA_ANTHROPIC_API_VERSION=2023-06-01
TEA_ANTHROPIC_REQUEST_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Optional live MCP stdio smoke
# ---------------------------------------------------------------------------

# This ignored test never discovers editor/ambient MCP settings. It creates
# isolated config/state/data directories and starts only the exact absolute
# command below. The model is scripted; the only live boundary is that command.
# Run it with:
#   TEA_MCP_LIVE_SMOKE=1 cargo test -p tea-cli --test mcp_live_smoke -- --ignored --nocapture
#
# The tool-arguments JSON becomes durable session content. Use deterministic,
# non-secret test input only. Environment values named below are passed to the
# child, so grant only narrowly scoped values.
TEA_MCP_LIVE_SMOKE=0
# TEA_MCP_LIVE_COMMAND=/absolute/path/to/mcp-server
# TEA_MCP_LIVE_ARGUMENTS_JSON=["--stdio"]
# TEA_MCP_LIVE_SERVER_ID=live
# TEA_MCP_LIVE_REMOTE_TOOL=echo
# TEA_MCP_LIVE_TOOL_ALIAS=mcp.live.echo
# TEA_MCP_LIVE_TOOL_ARGUMENTS_JSON={"value":"tea-mcp-live-smoke"}
# TEA_MCP_LIVE_INHERITED_ENVIRONMENT_JSON=[]
